{
    "$schema": "https://json.schemastore.org/tsconfig",
    "display": "Node.js",
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "target": "es2022",
        "lib": [
            "es2022"
        ],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "outDir": "dist",
    }
}